{% extends 'base.html.twig' %}

{% set title = 'account.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75">
        {# Insert the flashes #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle #}
        <h2 class="text-center text-md-start mb-2">
          {{ 'account.subtitles.myPassword'|trans }}
        </h2>

        {# Backlink #}
        <div class="mb-2">
          <a href="{{ path('account_index') }}"><span class="bi bi-arrow-left me-1" aria-hidden="true"></span> {{ 'account.link.backToIndex'|trans }}</a>
        </div>

        {# Change password form #}
        {{ form_start(form) }}
        {{ form_row(form.plainPassword) }}
        <div class="text-start">
          <button type="submit" class="btn btn-primary">Valider</button>
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
