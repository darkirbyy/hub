{% extends 'base.html.twig' %}

{% set title = 'account.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75">
        {# Insert the flashes #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle #}
        <h2 class="text-center text-md-start mb-2">
          {{ 'account.subtitles.updatePassword'|trans }}
        </h2>

        {# Backlink #}
        <div class="mb-2">
          <a href="{{ path('account_index') }}"><span class="bi bi-arrow-left me-1" aria-hidden="true"></span> {{ 'account.link.backToIndex'|trans }}</a>
        </div>

        {# Calculate strength translations #}
        {% set strengthKeys = ['veryWeak', 'weak', 'medium', 'strong', 'veryStrong'] %}
        {% set translatedStrengths = strengthKeys|map(s => ('enum.passwordStrengths.' ~ s)|trans({ }, 'messages'))|json_encode %}

        {# Change password form : use a stimulus controller to display the password strength live #}
        {{ form_start(form, { attr: { 'data-password-strength-strength-texts-value': translatedStrengths } }) }}

        <p class="mb-1">
          {{ 'account.other.passwordMinStrength'|trans }} "{{ ('enum.passwordStrengths.' ~ strengthKeys[form.vars.attr.passwordMinStrength])|trans({ }, 'messages') }}".
        </p>
        <div class="app-form-row">
          <p class="mb-1">
            <span class="text-muted">{{ 'account.other.passwordStrength'|trans }}</span> <strong data-password-strength-target="text">...</strong>
          </p>
          <div class="progress"
            role="progressbar"
            aria-label="{{ 'account.other.passwordStrength'|trans }}"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
            data-password-strength-target="bar">
            <div class="progress-bar"></div>
          </div>
        </div>
        {{ form_row(form.plainPassword.first, { attr: { 'data-password-strength-target': 'input' } }) }}
        {{ form_row(form.plainPassword.second) }}
        <div class="text-start">
          <button type="submit" class="btn btn-outline-primary">{{ 'form.button.confirm'|trans }}</button>
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
