{% extends 'base.html.twig' %}

{% set title = 'account.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75">
        {# Insert the flashes #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle #}
        <h2 class="text-center text-md-start mb-3">
          {{ ('account.subtitles.login.' ~ (loginType|default('normal')))|trans }}
        </h2>

        {# Login form #}
        {# Disable turbo : we may leave this app on login success #}
        {{ form_start(form, { attr: { 'data-turbo': 'false' } }) }}
        <p>
          {{ ('account.other.login.' ~ (loginType|default('normal')))|trans|raw }}
        </p>

        {{ form_row(form.username) }}
        {{ form_row(form.password) }}
        {{ form_row(form.rememberMe, loginType == 'forced' ? { row_attr: { class: 'd-none' } } : { }) }}
        <div class="text-start">
          <button type="submit" class="btn btn-outline-primary">{{ ('account.button.login.' ~ (loginType|default('normal')))|trans }}</button>
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
