{% extends 'base.html.twig' %}

{% set title = 'account.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75">
        {# Insert the flashes #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle #}
        <h2 class="text-center text-md-start mb-3">
          {{ 'account.subtitles.login'|trans }}
        </h2>

        {# Login form #}
        {{ form_start(form) }}
        {% for field in form.children %}
          {{ form_row(field) }}
        {% endfor %}
        {#
                  Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                  See https://symfony.com/doc/current/security/remember_me.html

                  <div class="checkbox mb-3">
                      <input type="checkbox" name="_remember_me" id="_remember_me">
                      <label for="_remember_me">Remember me</label>
                  </div>
              #}

        <div class="text-start">
          <button type="submit" class="btn btn-primary">{{ 'account.button.login'|trans }}</button>
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
