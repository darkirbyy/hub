{# Turbo frame displayed into the modal in the user main account page #}

<turbo-frame id="edit-avatar">
  {% if form is defined %}
    {{ form_start(form, { action: path('account_avatar') }) }}
    {{ form_row(form.imageFile) }}
    <div class="text-start">
      <button type="submit" class="btn btn-outline-primary">{{ 'form.button.confirm'|trans }}</button>
    </div>
    {{ form_end(form) }}
  {% else %}
    <turbo-stream action="redirect" target="{{ url }}"></turbo-stream>
  {% endif %}
</turbo-frame>
