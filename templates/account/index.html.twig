{% extends 'base.html.twig' %}

{% set title = 'account.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75">
        {# Subtitle and back link #}
        <h2 class="text-center text-md-start mb-4">
          {{ 'account.subtitles.myProfile'|trans }}
        </h2>

        {# Insert the flashes in the same col size as the form #}
        {{ block('flash', 'theme/flash.html.twig') }}
        <div class="col">
          <a class="btn btn-outline-primary" href="{{ path('account_logout') }}">{{ 'account.button.logout'|trans }}</a>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
