{% block button %}
  <button type="button" class="btn btn-outline-danger {{ btn_class|default('') }}" data-bs-toggle="modal" data-bs-target="#delete-modal" data-bs-object-id="{{ object_id }}">
    <span class="bi bi-trash-fill"></span>
    <span class="d-none d-sm-inline ms-1">{{ 'form.button.delete'|trans }}</span>
  </button>
{% endblock %}

{% block modal %}
  <div class="modal fade"
    id="delete-modal"
    tabindex="-1"
    aria-labelledby="delete-modal-label"
    aria-hidden="true"
    role="dialog"
    loading="lazy"
    {{ stimulus_controller('modal-adapt') }}>
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
      <div class="modal-content">
        {# Header with title and dismiss button #}
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="delete-modal-label">
            {{ 'form.modal.title'|trans }}
          </h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'aria.label.close'|trans }}"></button>
        </div>

        {# Body with message #}
        <div class="modal-body">
          {{ 'form.modal.body'|trans|raw }}
        </div>

        {# Footer with cancel or confirm buttons #}
        <div class="modal-footer">
          <form action="{{ path(config.route_prefix ~ 'delete', { id: 1 }) }}" method="post">
            <button type="submit" class="btn btn-danger">
              <span class="bi bi-trash-fill me-1"></span>
              {{ 'form.button.delete'|trans }}
            </button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'form.button.cancel'|trans }}</button>
            <input type="hidden" name="delete_token" value="{{ csrf_token('delete-' ~ '1') }}" />
          </form>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
