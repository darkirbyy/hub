{% extends 'base.html.twig' %}

{# the object_id set if it's EDIT mode or NEW mode #}
{% set object_id = app.request.attributes.get('id') %}

{% set title = config.main_title|trans %}

{% if object_id is not null %}
  {% set subtitle = 'form.title.update'|trans %}
  {% set submitButton = 'form.button.update'|trans %}
{% else %}
  {% set subtitle = 'form.title.add'|trans %}
  {% set submitButton = 'form.button.add'|trans %}
{% endif %}

{% block main %}
  {# Modal to confirm delete, if in EDIT mode #}
  {% if object_id is not null %}
    {{ block('modal', 'abstract/crud/_delete.html.twig') }}
  {% endif %}

  <section>
    <div class="container">
      <div class="row mx-auto w-100 w-md-75">
        {# Insert the flashes in the same col size as the form #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle and back link #}
        <h2>
          {{ (config.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ subtitle }}</span>
        </h2>
        <div class="my-2">
          <a href="{{ path(config.route_prefix ~ 'index') }}"><span class="bi bi-arrow-left me-1"></span> {{ 'form.other.backToList'|trans }}</a>
        </div>

        {# Form #}
        {{ form_start(form) }}
        {{ form_widget(form) }}

        {# Buttons to submit, or open the delete modal on right/left layout #}
        <div class="d-flex justify-content-between">
          {# Left part : submit #}
          <button type="submit" class="btn btn-primary">{{ submitButton }}</button>
          {# Right part (if in EDIT mode) : open delete modal #}
          {% if object_id is not null %}
            {% with { object_id: object_id } %}
            {{ block('button', 'abstract/crud/_delete.html.twig') }}
            {% endwith %}
          {% endif %}
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
