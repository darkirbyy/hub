{% extends 'base.html.twig' %}

{% set title = config.main_title|trans %}

{% block main %}
  {# Modal to confirm delete #}
  {{ block('delete_modal', 'abstract/crud/_delete.html.twig') }}

  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      <h2>
        {{ (config.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.index'|trans }}</span>
      </h2>

      {# Back link and button to add new object #}
      <div class="d-flex justify-content-between align-items-center">
        <a href="{{ path(config.index_backlink.route) }}"><span class="bi bi-arrow-left me-1"></span>{{ config.index_backlink.text|trans }}</a>
        <a href="{{ path(config.route_prefix ~ 'new') }}" class="btn btn-primary">
          <span class="bi bi-plus-square-fill me-md-1"></span>
          <span class="d-none d-md-inline">{{ 'form.button.new'|trans }}</span>
        </a>
      </div>

      {# Table displaying all objects #}
      <table class="mt-2 table table-striped">
        <thead>
          <tr class="">
            {% for col in config.index_cols|ksort %}
              <th class="text-nowrap align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}" scope="col">
                {{ (config.entity_key ~ '.label.' ~ col.getter)|trans({ }, 'validators') }}
              </th>
            {% endfor %}
            <th class="w-1 text-nowrap text-end align-center" scope="col">
              {{ 'form.other.action'|trans }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for object in objects %}
            <tr>
              {% for col in config.index_cols|ksort %}
                <td class="align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}">
                  {% set value = attribute(object, col.getter) %}
                  {{ col.raw|default(false) ? value|raw : value }}
                </td>
              {% endfor %}
              <td class="w-1 text-nowrap text-end py-1 align-center">
                <a class="btn btn-outline-primary btn-sm px-2 py-1" href="{{ path(config.route_prefix ~ 'edit', { id: object.id }) }}">
                  <span class="bi bi-pen-fill"></span><span class="d-none">{{ 'form.button.edit'|trans }}</span>
                </a>
                {% with { path: path(config.route_prefix ~ 'delete', { id: object.id }), token: csrf_token('delete-' ~ object.id), btn_class: 'btn-sm px-2 py-1' } %}
                {{ block('delete_button', 'abstract/crud/_delete.html.twig') }}
                {% endwith %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
