{% extends 'base.html.twig' %}

{% set title = config.main_title|trans %}

{% block main %}
  {# Modal to confirm delete, if in EDIT mode #}
  {{ block('modal', 'abstract/crud/_delete.html.twig') }}
  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      <h2>
        {{ (config.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.index'|trans }}</span>
      </h2>

      {# Back link and button to add new object #}
      <div class="d-flex justify-content-between align-items-center">
        <a href="{{ path(config.index_backlink.route) }}"><span class="bi bi-arrow-left me-1"></span>{{ config.index_backlink.text|trans }}</a>
        <a href="{{ path(config.route_prefix ~ 'new') }}" class="btn btn-primary">
          <span class="bi bi-plus-square-fill me-sm-1"></span>
          <span class="d-none d-sm-inline">{{ 'form.button.new'|trans }}</span>
        </a>
      </div>

      {# Table displaying all objects #}
      <table class="mt-2 table table-striped">
        <thead>
          <tr class="">
            {% for col in config.index_cols %}
              <th class="text-nowrap align-center" scope="col">
                {{ (config.entity_key ~ '.label.' ~ col)|trans({ }, 'validators') }}
              </th>
            {% endfor %}
            <th class="w-1 text-nowrap text-end align-center" scope="col">
              {{ 'form.other.action'|trans }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for object in objects %}
            <tr>
              {% for col in config.index_cols %}
                <td class="align-center">
                  {# TODO Dangerous ? #}
                  {{ attribute(object, col)|raw }}
                </td>
              {% endfor %}
              <td class="w-1 text-nowrap text-end py-1 align-center">
                <a class="btn btn-outline-primary btn-sm px-2 py-1" href="{{ path(config.route_prefix ~ 'edit', { id: object.id }) }}">
                  <span class="bi bi-pen-fill"></span><span class="ms-1 d-none d-sm-inline">{{ 'form.button.edit'|trans }}</span>
                </a>
                {% with { object_id: object.id, btn_class: 'btn-sm btn-sm px-2 py-1' } %}
                {{ block('button', 'abstract/crud/_delete.html.twig') }}
                {% endwith %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
