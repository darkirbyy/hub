<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# <meta name="turbo-refresh-method" content="morph" /> #}
    {# <meta name="turbo-refresh-scroll" content="preserve" /> #}
    <title>
      {{ title ~ ' - ' ~ ('layout.name'|trans) }}
    </title>
    <link rel="icon" href="{{ asset('build/images/favicon.png') }}" />
    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </head>

  <body class="d-flex flex-column min-vh-100" data-controller="load-popover">
    {# Bar not visible in prod env #}
    {% if env.app.env != 'prod' %}
      <div class="container-fluid p-0 m-0 text-center fw-bold d-flex justify-content-around app-env-dev">
        {% for i in 1..10 %}
          <div>
            {{ env.app.env|upper }}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# Skip to content link for screen reader #}
    <div class="app-navbar-bg-color ps-3 app-skip-link">
      <a class="icon-link visually-hidden-focusable" href="#mainContent">{{ 'aria.skipToContent'|trans }}</a>
    </div>

    {# The HEADER defines the navbar #}
    <header>
      {% set currentRoute = app.current_route %}
      {% set activeLink = 'class="nav-link app-navbar-btn py-1 active" aria-current="page" aria-selected="true"' %}
      {% set otherLink = 'class="nav-link app-navbar-btn py-1"' %}
      <nav class="navbar navbar-expand app-navbar-bg-color {{ currentRoute starts with 'home' ? '' : 'border-bottom app-navbar-neon' }}"
        aria-label="{{ 'aria.mainNavigation'|trans }}">
        <div class="container-fluid">
          {# Left part of the navbar #}
          <ul class="navbar-nav me-auto align-items-center gap-1">
            <li class="nav-item fs-5">
              <a {{ currentRoute starts with 'home' ? activeLink|raw : otherLink|raw }} href="{{ path('home_index') }}">
                <span class="fa-solid fa-house me-2" aria-hidden="true"></span>{{ 'layout.navbar.home'|trans }}
              </a>
            </li>
            {% if is_granted('ROLE_ADMIN') %}
              <li class="nav-item fs-5">
                <a {{ currentRoute starts with 'admin' ? activeLink|raw : otherLink|raw }} href="{{ path('admin_index') }}">{{ 'layout.navbar.admin'|trans }}</a>
              </li>
            {% endif %}
          </ul>
          {# Right part of the navbar : connect or go to your account page #}
          <ul class="navbar-nav align-items-center gap-1">
            {% if is_granted('ROLE_USER') %}
              <li class="nav-item">
                <a {{ currentRoute starts with 'account' ? activeLink|raw : otherLink|raw }} href="{{ path('account_index') }}">
                  {{ app.user.username }}
                  <div class="app-avatar-container-xs d-inline-block ms-1">
                    <img src="{{ app.user|get_image_path('default-avatar.png') }}" class="app-avatar-img" alt="" />
                  </div>
                </a>
              </li>
            {% else %}
              <li class="nav-item">
                <a {{ currentRoute starts with 'account' ? activeLink|raw : otherLink|raw }} href="{{ path('account_login') }}">{{ 'layout.navbar.login'|trans }}</a>
              </li>
            {% endif %}
            <li class="nav-item">
              <button data-bs-toggle="modal" data-bs-target="#theme-modal" class="nav-link app-navbar-btn py-1" aria-label="{{ 'aria.switchTheme'|trans }}">
                <span class="bi bi-palette" aria-hidden="true"></span>
              </button>
            </li>
          </ul>
        </div>
      </nav>
    </header>

    {# The main block MUST be redefined on each page, including the flash block in the right place
       The h1 block CAN be redefined on a page, to customize the h1 title #}
    <main class="flex-grow-1" role="main" id="mainContent">
      {% block h1 %}
        <div class="container-fluid p-0 py-2 mt-4 mb-2">
          <h1 class="text-center">
            {{ title }}
          </h1>
        </div>
      {% endblock %}

      {% block main %}
        <section>
          <div class="container">
            {{ block('flash', 'theme/flash.html.twig') }}
            <div class="text-center">
              Some content !
            </div>
          </div>
        </section>
      {% endblock %}
    </main>

    {# The FOOTER divided in two part : left/right on large screen / on the top of each other on small screen #}
    <footer role="contentinfo" aria-label="{{ 'aria.footer'|trans }}">
      <div class="container-fluid fw-light app-navbar-bg-color app-navbar-text-color app-navbar-neon border-top small mt-5 py-3">
        <div class="row gw-md-4 app-navbar-muted-color">
          {# Left part : references to frameworks #}
          <div class="col-12 col-md-6 text-center text-md-end">
            {{ 'layout.footer.madeWith'|trans }}
            <span class="fa-brands fa-symfony" aria-hidden="true"></span>
            <span class="fst-italic">Symfony 7</span>
            <span class="mx-1">|</span>
            <span class="fa-brands fa-bootstrap" aria-hidden="true"></span>
            <span class="fst-italic">Bootstrap 5</span>
          </div>
          {# Right part : version and update of the app #}
          <div class="col-12 col-md-6 text-center text-md-start">
            {{ ('layout.footer.version'|trans) ~ ' ' ~ env.versioning.version ~ ' - ' ~ ('layout.footer.releaseDate'|trans) ~ ' '
              ~ (env.versioning.release_date|format_datetime('short', 'none')) }}
          </div>
        </div>
      </div>
    </footer>

    {# Switch theme modal #}
    <div class="modal fade" id="theme-modal" tabindex="-1" aria-labelledby="theme-modal-label" aria-hidden="true" data-controller="switch-theme">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="theme-modal-label">
              {{ 'layout.theme.switch'|trans }}
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body d-flex flex-column gap-2">
            <button class="btn btn-outline-secondary text-start app-switch-theme-btn" data-switch-theme-target="button" id="theme-modal-light">
              <span class="bi bi-sun me-2" aria-hidden="true"></span>{{ 'layout.theme.light'|trans }}
            </button>
            <button class="btn btn-outline-secondary text-start app-switch-theme-btn" data-switch-theme-target="button" id="theme-modal-dark">
              <span class="bi bi-moon me-2" aria-hidden="true"></span>{{ 'layout.theme.dark'|trans }}
            </button>
            <button class="btn btn-outline-secondary text-start app-switch-theme-btn" data-switch-theme-target="button" id="theme-modal-auto">
              <span class="bi bi-gear me-2" aria-hidden="true"></span>{{ 'layout.theme.auto'|trans|raw }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
