{% extends 'base.html.twig' %}

{% set title = 'default.title'|trans %}

{% block main %}
  <div class="container">
    {{ block('flash', 'theme/flash.html.twig') }}

    {% for category in categories %}
      <h2 class="mb-4">
        <span class="{{ category.icon.faClass }} me-2"></span> {{ category.label }}
      </h2>

      <div class="d-flex gap-3 justify-content-start flex-row flex-wrap">
        {% for appli in category.applis %}
          {% set appli_url = appli.path %}
          <div class="card" style="width: 18rem;">
            <a href="{{ appli_url }}"><img src="{{ vich_uploader_asset(appli, 'imageFile') }}" class="card-img-top" alt="{{ appli.name }}" /></a>
            <div class="card-body bg-light">
              <h5 class="card-title">
                {{ appli.name }}
              </h5>
              <p class="card-text">
                {{ appli.description }}
              </p>
              <div class="text-right">
                <a href="{{ appli_url }}" class="btn btn-secondary">{{ appli.linkText }}</a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
{% endblock %}
