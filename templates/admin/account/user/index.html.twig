{% extends 'base.html.twig' %}

{% set title = 'admin.accounts'|trans %}

{% block main %}
  {# Modal to confirm delete #}
  {# {{ block('delete_modal', 'theme/crud/_delete.html.twig') }} #}

  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      <h2>
        {{ 'user.name'|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.index'|trans }}</span>
      </h2>

      {# Back link and button to add new object #}
      <div class="d-flex justify-content-between align-items-center">
        <a href="{{ path('admin_index') }}"><span class="bi bi-arrow-left me-1"></span>{{ 'admin.backTo'|trans }}</a>
        <a href="{{ path('admin_account_user_new') }}" class="btn btn-primary">
          <span class="bi bi-plus-square-fill me-md-1"></span>
          <span class="d-none d-md-inline">{{ 'form.button.new'|trans }}</span>
        </a>
      </div>

      {# Table displaying all objects #}
      <table class="mt-2 table table-striped">
        <thead>
          <tr>
            {% for col in cols|ksort %}
              <th class="text-nowrap align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}" scope="col">
                {{ ('user.label.' ~ col.getter)|trans({ }, 'validators') }}
              </th>
            {% endfor %}
            <th class="w-1 text-nowrap text-end align-center" scope="col">
              {{ 'form.other.action'|trans }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for user in users %}
            <tr>
              {% for col in cols|ksort %}
                <td class="align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}">
                  {% set value = attribute(user, col.getter) %}
                  {{ value }}
                </td>
              {% endfor %}
              <td class="w-1 text-nowrap text-end py-1 align-center">
                <a class="btn btn-outline-primary btn-sm px-2 py-1" href="{{ path('admin_account_user_show', { id: user.id }) }}">
                  <span class="bi bi-eye-fill me-1"></span>{{ 'form.button.see'|trans }}
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
