{% extends 'base.html.twig' %}

{% set title = 'admin.accounts'|trans %}

{# the object_id from the route parameters #}
{% set user_id = app.request.attributes.get('id') %}
{% set cancel_location = path('admin_account_user_show', { id: user_id }) %}
{% block main %}
  <section>
    <div class="container">
      <div class="row mx-auto w-100 w-md-75">
        {# Insert the flashes in the same col size as the form #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle and back link #}
        <h2>
          {{ 'user.name'|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.add'|trans }}</span>
        </h2>
        <div class="my-2">
          <a href="{{ cancel_location }}"><span class="bi bi-arrow-left me-1"></span> {{ 'form.other.backToSee'|trans }}</a>
        </div>

        {# Actual form #}
        <turbo-frame id="edit">
          {{ form_start(form, { action: app.request.uri }) }}
          <div class="row mx-2 border-bottom mb-2 rounded align-items-center bg-body-secondary">
            <div class="col-5 col-md-4 py-2 text-truncate">
              {{ 'user.label.username'|trans({ }, 'validators') }}
            </div>

            <div class="col-4 col-md-4 py-2">
              {{ form_widget(form) }}
            </div>
            <div class="col-3 col-md-4 py-1 text-end">
              <div class="text-end">
                <button type="submit" class="btn btn-sm btn-outline-primary">
                  <span class="bi bi-floppy-fill"></span>
                  <span class="d-none d-md-inline ms-md-1">{{ 'form.button.save'|trans }}</span>
                </button>
                <a href="{{ cancel_location }}" class="btn btn-sm btn-outline-secondary">
                  <span class="bi bi-x-lg"></span>
                  <span class="d-none ms-md-1">{{ 'form.button.cancel'|trans }}</span>
                </a>
              </div>
            </div>
          </div>
          {{ form_end(form) }}
        </turbo-frame>
      </div>
    </div>
  </section>
{% endblock %}
