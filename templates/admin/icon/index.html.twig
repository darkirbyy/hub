{% extends 'base.html.twig' %}

{% set title = 'form.title.index'|trans %}

{% block main %}
  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      {# Back link and button to add new object #}
      <div class="d-flex justify-content-between">
        <a href="{{ path('default_index') }}"><span class="bi bi-arrow-left me-1"></span>Retour à l'administration</a>
        <a href="{{ path('admin_icon_new') }}" class="btn btn-primary">
          <span class="bi bi-plus-square-fill me-md-1"></span>
          <span class="d-none d-md-inline">{{ 'form.button.new'|trans }}</span>
        </a>
      </div>

      {# Table displaying all objects #}
      <table class="mt-2 table table table-striped">
        <thead>
          <tr class="">
            <th scope="col">
              #
            </th>
            <th scope="col">
              {{ 'icon.label.label'|trans({ }, 'validators') }}
            </th>
            <th scope="col">
              {{ 'icon.label.faClass'|trans({ }, 'validators') }}
            </th>
            <th scope="col">
              {{ 'form.other.action'|trans }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for object in objects %}
            <tr>
              <th scope="row">
                {{ object.id }}
              </th>
              <td>
                {{ object.label }}
              </td>
              <td>
                {{ object.faClass }}
              </td>
              <td>
                <a class="btn btn-sm btn-outline-primary p-0 px-2 py-1" href="{{ path('admin_icon_edit', { id: object.id }) }}">
                  <span class="bi bi-pen-fill"></span><span class="ms-1 d-none">{{ 'form.button.edit'|trans }}</span>
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
