{% extends 'base.html.twig' %}

{% set title = 'admin.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      {{ block('flash', 'theme/flash.html.twig') }}
      <a href="{{ path('admin_icon_index') }}">{{ 'icon.name'|trans({ }, 'validators') }}<span class="bi bi-arrow-right ms-1"></span></a>
      <a href="{{ path('admin_category_index') }}">{{ 'category.name'|trans({ }, 'validators') }}<span class="bi bi-arrow-right ms-1"></span></a>
    </div>
  </section>
{% endblock %}
