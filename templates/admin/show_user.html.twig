{# Extends the crud show page to override one block #}
{% extends 'theme/crud/show.html.twig' %}

{% set title = 'admin.title'|trans %}

{# Override the corresponding block in the crud to add the reset button #}
{% block buttons_action %}
  <div>
    <a href="{{ path('admin_account_user_edit', { id: object.id }) }}" class="btn btn-outline-secondary" aria-label="{{ 'form.button.edit'|trans }}" data-turbo-prefetch="false">
      <span class="bi bi-pen" aria-hidden="true"></span><span class="d-none d-md-inline ms-md-1">{{ 'form.button.edit'|trans }}</span>
    </a>
    <a href="{{ path('admin_account_user_reset', { id: object.id }) }}" class="btn btn-outline-secondary" aria-label="{{ 'form.button.reset'|trans }}" data-turbo-prefetch="false">
      <span class="bi bi-eraser" aria-hidden="true"></span><span class="d-none d-md-inline ms-md-1">{{ 'form.button.reset'|trans }}</span>
    </a>
    {% with {
      path: path('admin_account_user_delete', { id: object.id }),
      token: csrf_token('delete-' ~ object.id),
      body_param: { object: object },
      btn_class: '',
      text_class: 'd-md-inline ms-md-1',
    }
    %}

    {{ block('delete', 'theme/crud/_button.html.twig') }}
    {% endwith %}
  </div>
{% endblock %}
