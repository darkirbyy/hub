{% extends 'base.html.twig' %}

{% set title = config_main.main_title|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75 py-2">
        {# Insert the flashes #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle #}
        <h2>
          {{ (config_main.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.new'|trans }}</span>
        </h2>

        <div class="my-2 d-flex justify-content-between align-items-center">
          {# Back link #}
          <a href="{{ path(config_main.route_prefix ~ 'index') }}"><span class="bi bi-arrow-left me-1" aria-hidden="true"></span> {{ 'form.link.backToList'|trans }}</a>
          {# Buttons (none) #}
          {% block buttons_action %}
            <div></div>
          {% endblock %}
        </div>

        {# Crud form #}
        {{ block('form', 'theme/crud/_form.html.twig') }}
      </div>
    </div>
  </section>
{% endblock %}
