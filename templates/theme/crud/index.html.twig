{% extends 'base.html.twig' %}

{% set title = config_main.main_title|trans %}

{% block main %}
  {# Modal to confirm delete #}
  {{ block('delete', 'theme/crud/_modal.html.twig') }}

  <section>
    <div class="container">
      {# Redefine the flashes with the same width as the cards #}
      <div class="mx-auto">
        {{ block('flash', 'theme/flash.html.twig') }}
      </div>

      <h2>
        {{ (config_main.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.index'|trans }}</span>
      </h2>

      {# Back link and button to add new object #}
      <div class="d-flex justify-content-between align-items-center">
        <a href="{{ path(config_index.backlink.route) }}"><span class="bi bi-arrow-left me-1"></span>{{ config_index.backlink.text|trans }}</a>
        {% if config_index.button.new %}
          {% with { path: path(config_main.route_prefix ~ 'new'), text_class: 'd-md-inline ms-md-1' } %}
          {{ block('new', 'theme/crud/_button.html.twig') }}
          {% endwith %}
        {% endif %}
      </div>

      {# Table displaying all objects #}
      <table class="mt-2 table table-striped">
        <thead>
          <tr>
            {% for col in config_index.cols|ksort %}
              <th class="text-nowrap align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}" scope="col">
                {{ (config_main.entity_key ~ '.label.' ~ (col.label is defined ? col.label : col.getter))|trans({ }, 'validators') }}
              </th>
            {% endfor %}
            <th class="w-1 text-nowrap text-end align-center" scope="col">
              {{ 'form.other.action'|trans }}
            </th>
          </tr>
        </thead>
        <tbody class="table-group-divider">
          {% if config_index.sort is not empty %}
            {% set objects = objects|sort((a, b) => deep_attribute(a, config_index.sort) <=> deep_attribute(b, config_index.sort)) %}
          {% endif %}

          {% for object in objects %}
            <tr>
              {% for col in config_index.cols|ksort %}
                <td class="align-center {{ col.breakpoint|default('xs') != 'xs' ? 'd-none d-' ~ col.breakpoint ~ '-table-cell' }}">
                  {% set value = deep_attribute(object, col.getter) %}
                  {{ col.filters is defined ? value|apply_filters(col.filters) : value }}
                </td>
              {% endfor %}
              <td class="w-1 text-nowrap text-end py-1 align-center">
                {% if config_index.button.show %}
                  {% with { path: path(config_main.route_prefix ~ 'show', { id: object.id }), btn_class: 'btn-sm px-2 py-1' } %}
                  {{ block('show', 'theme/crud/_button.html.twig') }}
                  {% endwith %}
                {% endif %}
                {% if config_index.button.edit %}
                  {% with { path: path(config_main.route_prefix ~ 'edit', { id: object.id }), btn_class: 'btn-sm px-2 py-1' } %}
                  {{ block('edit', 'theme/crud/_button.html.twig') }}
                  {% endwith %}
                {% endif %}
                {% if config_index.button.delete %}
                  {% with { path: path(config_main.route_prefix ~ 'delete', { id: object.id }), token: csrf_token('delete-' ~ object.id), btn_class: 'btn-sm px-2 py-1' } %}
                  {{ block('delete', 'theme/crud/_button.html.twig') }}
                  {% endwith %}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
