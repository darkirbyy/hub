{% extends 'base.html.twig' %}

{% set title = config_main.main_title|trans %}

{% block main %}
  {# Modal to confirm delete #}
  {{ block('delete', 'theme/crud/_modal.html.twig') }}

  <section>
    <div class="container">
      <div class="mx-auto w-100 w-md-75 py-2">
        {# Insert the flashes in the same col size as the form #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {# Subtitle and back link + delete button #}
        <h2>
          {{ (config_main.entity_key ~ '.name')|trans({ }, 'validators') }} <span class="fs-5">- {{ 'form.title.edit'|trans }}</span>
        </h2>
        <div class="my-2 d-flex justify-content-between align-items-center">
          <a href="{{ path(config_main.route_prefix ~ 'show', { id: object.id }) }}">
            <span class="bi bi-arrow-left me-1" aria-hidden="true"></span> {{ 'form.link.backToSee'|trans }}
          </a>
          {% if config_edit.button.delete %}
            {% with {
              path: path(config_main.route_prefix ~ 'delete', { id: object.id }),
              token: csrf_token('delete-' ~ object.id),
              body_param: { object: object },
              text_class: 'd-md-inline ms-1',
            }
            %}
            {{ block('delete', 'theme/crud/_button.html.twig') }}
            {% endwith %}
          {% endif %}
        </div>

        {# Actual form #}
        {{ block('form', 'theme/crud/_form.html.twig') }}
      </div>
    </div>
  </section>
{% endblock %}
