{% block error %}
  <section>
    <div class="container">
      <p class="text-center fs-4">
        {{ ('error.message.' ~ error_key)|trans }}
      </p>
      <p class="text-center">
        <a href="{{ path('home_index') }}" class="btn btn-outline-primary" aria-label="{{ 'form.button.edit'|trans }}">Retour à l'accueil</a>
      </p>
    </div>
  </section>
{% endblock %}
