{# Extends and improve bootstrap form theme #}
{% extends 'bootstrap_5_layout.html.twig' %}

{# Customizes form field with help button at the end, and floating labels if there is a placeholder defined #}
{% block form_row %}
  {# Creates the help button as a icon + help text in a popover #}
  {% set help_button %}
    {% if form.vars.help is not empty %}
      <button type="button"
        aria-label="{{ 'form.button.help'|trans }}"
        class="btn btn-outline-info py-0 app-btn-border-light {{ form.vars.valid == false ? 'is-invalid' }}"
        data-bs-toggle="popover"
        {{ form.vars.help_html ? 'data-bs-html="true"' }}
        data-bs-content="{{ form.vars.help|trans(form.vars.help_translation_parameters|map(p => p|e), form.vars.translation_domain) }}">
        <span class="fs-5 bi bi-info-circle" aria-hidden="true"></span>
      </button>
    {% endif %}
  {% endset %}

  {# Calculates the row_attr with `app-form-row` + `has_validation` (if errors) + custom row attributes #}
  {% set custom_classes = 'app-form-row' ~ ' ' ~ (not compound or (force_error|default(false)) ? (errors|length) > 0 ? 'has-validation') %}
  {% set attributes %}
    {% with { attr: row_attr|merge({ class: ((row_attr.class|default('')) ~ ' ' ~ custom_classes)|trim }) } %}
    {{ block('attributes') }}
    {% endwith %}
  {% endset %}

  {# Creates the actual div with its attributes #}
  <div {{ attributes }}>
    {# If a placeholder attribute is declared: use the floating row with the label afterwards + add the help button is needed #}
    {% if form.vars.attr.placeholder is defined %}
      <div class="input-group">
        <div class="form-floating">
          {{ form_widget(form, { attr: { class: form.vars.attr.button_action|default('') is not empty ? 'pe-5' } }) }}
          {{ form_label(form) }}
          {% if form.vars.attr.button_action|default('') is not empty %}
            <small>
              <button type="button"
                aria-label="{{ ('form.button.' ~ form.vars.attr.button_action)|trans }}"
                data-button-action-target="{{ form.vars.attr.button_action }}"
                data-button-action-id="{{ form.vars.id }}"
                class="app-button-action btn-close position-absolute top-50 end-0 translate-middle-y {{ form.vars.valid == false ? 'is-invalid' }}"
                tabindex="-1">
                <span class="fa-solid fa-lg" aria-hidden="true"></span>
              </button>
            </small>
          {% endif %}
        </div>
        {{ help_button }}
      </div>
      {# Else: use the normal row with the label first, and pass the help button to the widget #}
    {% else %}
      {{ form_label(form) }}
      {{ form_widget(form, { help_button: help_button }) }}
    {% endif %}
    {# In any case, write the errors underneath #}
    {{ form_errors(form) }}
  </div>
{% endblock %}

{# Customize vich uploader widget to add the help button and classes to the rendered img #}
{%- block vich_image_widget -%}
  {%- if (errors|length) > 0 -%}
    {%- set attr = attr|merge({ class: ((attr.class|default('')) ~ ' is-invalid')|trim }) -%}
  {%- endif -%}
  <div class="input-group">
    {{- form_widget(form.file, { attr: attr }) -}}
    {# Add the help button at the end of the row #}
    {{ help_button|default('') }}
  </div>

  {# Button to delete if allowed #}
  {%- if form.delete is defined -%}
    {{- form_row(form.delete, { label: 'form.other.deleteImage', translation_domain: 'messages', row_attr: { class: 'my-2' } }) -}}
  {%- endif -%}

  {# Links (as text or image) to download the image if allowed #}
  {% if not errors|length > 0 %}
    {%- if image_uri -%}
      <div class="text-center mt-2">
        <a href="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" download tabindex="-1">
          <img class="{{ row_attr.image_class|default('app-img-fluid') }}"
            src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}"
            alt="{{ 'form.button.download'|trans }}" />
        </a>
      </div>
    {%- endif -%}
    {%- if download_uri -%}
      <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" download>
        {{ translation_domain is same as(false) ? download_label : download_label|trans({ }, translation_domain) }}
      </a>
    {%- endif -%}
  {% endif %}
{%- endblock -%}

{# Custom collection changes to add button and javascript controller #}
{# Add stimulus controller #}
{% block collection_row %}
  {% set custom_row_attr = { 'data-controller': 'collec-field' } %}
  {% set row_attr = row_attr|merge(custom_row_attr) %}
  {{- form_row(form, { row_attr: row_attr }) -}}
{% endblock %}

{# Add two mandatory targets and the add button #}
{% block collection_widget %}
  {% set custom_attr = { 'data-collec-field-target': 'collec' } %}
  {% set attr = attr|merge(custom_attr) %}
  {{- parent() -}}
  <button class="btn btn-outline-secondary" type="button" data-collec-field-target="add">
    <span class="bi bi-plus-square me-1" aria-hidden="true"></span>{{ 'form.button.new'|trans }}
  </button>
{% endblock %}

{# Add one mandatory target and the delete button #}
{% block collection_entry_row %}
  <div class="d-flex gap-2">
    {% for row in form.children %}
      {{ form_row(row) }}
    {% endfor %}
    <button class="btn btn-outline-danger app-btn-max-height mb-3" type="button" data-collec-field-target="remove"><span class="bi bi-trash" aria-hidden="true"></span></button>
  </div>
{% endblock %}

{# Improve choice type form when `expanded` and `multiple` are true, and group_by is defined #}
{%- block choice_widget_expanded -%}
  {%- set attr = attr|merge({ class: attr.class|default('mt-2') }) -%}
  <div {{ block('widget_container_attributes') }}>
    {%- set options = choices -%}
    {{- block('choice_widget_expanded_options') -}}
  </div>
{%- endblock -%}

{%- block choice_widget_expanded_options -%}
  {%- for group_label, option in options -%}
    {%- if option is iterable -%}
      <fieldset>
        <h6 class="fw-bold">
          {{ choice_translation_domain is same as(false) ? group_label : group_label|trans({ }, choice_translation_domain) }}
        </h6>
        {%- set options = option -%}
        {{- block('choice_widget_expanded_options') -}}
      </fieldset>
    {%- else -%}
      <div>
        {%- set child = form.children|filter(child => child.vars.value == option.value)|first -%}
        {{- form_widget(child) -}}
        {{- form_label(child) -}}
      </div>
    {%- endif -%}
  {% endfor %}
{% endblock %}
