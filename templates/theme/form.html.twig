{% extends 'bootstrap_5_layout.html.twig' %}

{# Customize form field with help button at the end, and floating labels if there is a placeholder defined #}
{% block form_row %}
  {% set help_button %}
    {% if form.vars.help is not empty %}
      <button type="button"
        class="btn btn-outline-secondary py-0 app-btn-border-light {{ form.vars.valid == false ? 'is-invalid' }}"
        data-bs-toggle="popover"
        {{ form.vars.help_html ? 'data-bs-html="true"' }}
        data-bs-content="{{ form.vars.help|trans(form.vars.help_translation_parameters, form.vars.translation_domain) }}">
        <span class="fs-5 bi bi-info-circle"></span>
      </button>
    {% endif %}
  {% endset %}

  {% set custom_classes = 'app-form-row' ~ ' ' ~ (not compound or (force_error|default(false)) ? (errors|length) > 0 ? 'has-validation') %}
  {% set attributes %}
    {% with { attr: row_attr|merge({ class: ((row_attr.class|default('')) ~ ' ' ~ custom_classes)|trim }) } %}
    {{ block('attributes') }}
    {% endwith %}
  {% endset %}

  <div {{ attributes }}>
    {% if form.vars.attr.placeholder is defined %}
      <div class="input-group">
        <div class="form-floating">
          {{ form_widget(form, { attr: { class: form.vars.attr.clear_button|default(false) ? 'pe-5' : '' } }) }}
          {{ form_label(form) }}
          {% if (form.vars.attr.clear_button|default(false)) == true %}
            <small>
              <button type="button"
                data-app-clear-id="{{ form.vars.id }}"
                class="app-btn-clear btn-close position-absolute top-50 end-0 translate-middle-y {{ form.vars.valid == false ? 'is-invalid' }}">

              </button>
            </small>
          {% endif %}
        </div>
        {{ help_button }}
      </div>
    {% else %}
      {{ form_label(form) }}
      {{ form_widget(form, { help_button: help_button }) }}
    {% endif %}
    {{ form_errors(form) }}
  </div>
{% endblock %}

{# Customize vich uploader widget to add the help button and classes to the rendered img #}
{%- block vich_image_widget -%}
  {%- if (errors|length) > 0 -%}
    {%- set attr = attr|merge({ class: ((attr.class|default('')) ~ ' is-invalid')|trim }) -%}
  {%- endif -%}
  <div class="input-group">
    {{- form_widget(form.file, { attr: attr }) -}}
    {# {% if form.vars.attr.clear_button|default(true) == true %}
   <button class="btn btn-outline-secondary px-2 app-btn-border-light" type="button" data-app-clear-id="{{ form.vars.id }}"><span class="bi bi-x-lg"></span></button>
  {% endif %} #}
    {{ help_button|default('') }}
  </div>
  {%- if form.delete is defined -%}
    {{- form_row(form.delete) -}}
  {%- endif -%}

  {% if not errors|length > 0 %}
    {%- if image_uri -%}
      <div class="text-center mt-2">
        <a href="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" download>
          <img class="img-fluid" src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" alt="{{ 'aria.other.download'|trans }}" />
        </a>
      </div>
    {%- endif -%}
    {%- if download_uri -%}
      <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" download>
        {{ translation_domain is same as(false) ? download_label : download_label|trans({ }, translation_domain) }}
      </a>
    {%- endif -%}
  {% endif %}
{%- endblock -%}

{% block collection_row %}
  {% set custom_row_attr = { 'data-controller': 'collec-field' } %}
  {% set row_attr = row_attr|merge(custom_row_attr) %}
  {{- form_row(form, { row_attr: row_attr }) -}}
{% endblock %}

{% block collection_widget %}
  {% set custom_attr = { 'data-collec-field-target': 'collec' } %}
  {% set attr = attr|merge(custom_attr) %}
  {{- parent() -}}
  <button class="btn btn-outline-primary" type="button" data-collec-field-target="add"><span class="bi bi-plus-square-fill me-1"></span>{{ 'form.button.new'|trans }}</button>
{% endblock %}

{% block collection_entry_row %}
  <div class="d-flex gap-2">
    {% for row in form.children %}
      {{ form_row(row) }}
    {% endfor %}
    <button class="btn btn-outline-danger app-btn-max-height mb-3" type="button" data-collec-field-target="remove"><span class="bi bi-trash-fill"></span></button>
  </div>
{% endblock %}
