{% extends 'bootstrap_5_layout.html.twig' %}

{% block form_row %}
  {% set help_button %}
    {% if form.vars.help is not empty %}
      <button type="button"
        class="btn btn-outline-secondary app-btn-border-light {{ form.vars.valid == false ? 'is-invalid' }}"
        data-bs-toggle="popover"
        {{ form.vars.help_html ? 'data-bs-html="true"' }}
        data-bs-content="{{ form.vars.help|trans(form.vars.help_translation_parameters, form.vars.translation_domain) }}">
        <span class="bi bi-info-circle"></span>
      </button>
    {% endif %}
  {% endset %}
  {# {{ dump(form) }} #}
  <div class="app-form-row {{ form.vars.attr.placeholder is defined ? 'input-group' }} {{ form.vars.row_attr.class|default('') }} {% if not compound or force_error|default(false) %}{% for error in errors %}has-validation{% endfor %}{% endif %}">
    {% if form.vars.attr.placeholder is defined %}
      <div class="form-floating">
        {{ form_widget(form) }}
        {{ form_label(form) }}
      </div>
      {{ help_button }}
    {% else %}
      {{ form_label(form) }}
      {{ form_widget(form, { help_button: help_button }) }}
    {% endif %}
    {{ form_errors(form) }}
  </div>
{% endblock %}

{%- block vich_image_widget -%}
  {%- if (errors|length) > 0 -%}
    {%- set attr = attr|merge({ class: ((attr.class|default('')) ~ ' is-invalid')|trim }) -%}
  {%- endif -%}
  <div class="input-group">
    {{- form_widget(form.file, { attr: attr }) -}}
    {{ help_button|default('') }}
  </div>
  {%- if form.delete is defined -%}
    {{- form_row(form.delete) -}}
  {%- endif -%}

  {% if not errors|length > 0 %}
    {%- if image_uri -%}
      <div class="text-center mt-2">
        <a href="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" download>
          <img src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" alt="" />
        </a>
      </div>
    {%- endif -%}
    {%- if download_uri -%}
      <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" download>
        {{ translation_domain is same as(false) ? download_label : download_label|trans({ }, translation_domain) }}
      </a>
    {%- endif -%}
  {% endif %}
{%- endblock -%}

