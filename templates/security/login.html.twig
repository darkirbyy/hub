{% extends 'base.html.twig' %}

{% set title = 'security.title'|trans %}

{% block main %}
  <section>
    <div class="container">
      <div class="row mx-auto w-100 w-md-75">
        {# Subtitle and back link #}
        <h2 class="text-center text-md-start mb-4">
          {{ 'security.subtitles.login'|trans }}
        </h2>

        {# Insert the flashes in the same col size as the form #}
        {{ block('flash', 'theme/flash.html.twig') }}

        {{ form_start(form) }}
        {% for field in form.children %}
          {{ form_row(field) }}
        {% endfor %}
        {#
                  Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                  See https://symfony.com/doc/current/security/remember_me.html

                  <div class="checkbox mb-3">
                      <input type="checkbox" name="_remember_me" id="_remember_me">
                      <label for="_remember_me">Remember me</label>
                  </div>
              #}

        {# Buttons to submit #}
        <div class="text-start">
          <button type="submit" class="btn btn-primary">{{ 'security.button.login'|trans }}</button>
        </div>
        {{ form_end(form) }}
      </div>
    </div>
  </section>
{% endblock %}
