{% extends 'base.html.twig' %}

{% set title = 'home.title'|trans %}

{# Redefines the h1 block to extend the navbar background with an intro text and custom borders #}
{% block h1 %}
  <div class="container-fluid p-0 mb-5 app-home-gradient app-navbar-text-color app-navbar-bg-color">
    <div class="container">
      <h1 class="text-center">
        {{ 'home.h1'|trans }}
      </h1>
      <div class="px-4 fs-5 text-center">
        <p class="mb-0">
          {{ 'home.introText'|trans|raw }}
        </p>
        <p class="mb-0 app-home-havefun">
          <span class="px-5 py-2 fs-4 border border-3 app-navbar-bg-color">{{ 'home.haveFun'|trans }}</span>
        </p>
      </div>
    </div>
  </div>
{% endblock %}

{# Actual content, displaying all available app by categories, with horizontal swiper #}
{% block main %}
  <div class="container mt-3">
    {# No flashes on the main home page #}
    {# {{ block('flash', 'theme/flash.html.twig') }} #}

    {# For each category, only display it if not empty #}
    {% for category in categories %}
      {% if (category.applis|length) > 0 %}
        <section class="mt-4" data-controller="main-carousel" data-main-carousel-id-value="{{ category.id }}">
          <div class="d-flex justify-content-start gap-1 gap-md-3 mb-4">
            {# Previous swiper button #}
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-prev" aria-label="{{ 'form.button.previous'|trans }}">
              <span class="fa-solid fa-chevron-left fa-xl" aria-hidden="true"></span>
            </button>
            {# Swiper content as two parts: the category title, and all corresponding applis #}
            <div class="swiper mx-0" id="swiper-{{ category.id }}-main">
              {# Category title #}
              <h2 class="m-3 text-center text-md-start">
                <span class="{{ category.icon.faClass|e }} fa-fw me-2"></span> {{ category.label }}
              </h2>
              {# All corresponding applis #}
              <div class="swiper-wrapper m-3">
                {# For each appli, calculate the full url and use a card to display it #}
                {% for appli in category.applis %}
                  {% set appli_url = server_base_url ~ appli.path %}
                  <div class="card swiper-slide app-home-card">
                    {# Card top with a clickable image #}
                    <a href="{{ appli_url }}" class="border-bottom border-2 d-flex align-items-center app-home-card-header" data-turbo="false">
                      <img src="{{ appli|get_image_path('default-appli.png') }}" class="card-img app-img-fluid app-home-card-img" alt="{{ appli.title }}" />
                    </a>
                    {# Card body in three vertical flex parts: appli title, description and buttons #}
                    <div class="card-body d-flex flex-column justify-content-between">
                      {# Appli title #}
                      <h5 class="card-title">
                        {{ appli.title }}
                      </h5>
                      {# Appli description #}
                      <p class="app-home-card-text flex-grow-1">
                        {{ appli.description }}
                      </p>
                      {# Appli buttons as two parts: main button and external links #}
                      <div class="d-flex flex-row gap-2 justify-content-start align-items-end">
                        {# Main button #}
                        <div class="flex-fill text-start">
                          <a href="{{ appli_url }}" class="btn btn-outline-primary" data-turbo="false">{{ appli.linkText }}</a>
                        </div>
                        {# All externals links #}
                        {% for externalLink in appli.externalLinks %}
                          <div>
                            <a href="{{ externalLink.url }}" class="btn btn-sm btn-outline-secondary py-0 px-1 fs-5" title="{{ externalLink.text }}" data-turbo="false">
                              <span class="{{ externalLink.icon.faClass }}" aria-hidden="true"></span>
                            </a>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>

            {# Next swiper button #}
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-next" aria-label="{{ 'form.button.next'|trans }}">
              <span class="fa-solid fa-chevron-right fa-xl" aria-hidden="true"></span>
            </button>
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
