{% extends 'base.html.twig' %}

{% set title = 'home.title'|trans %}

{% block h1 %}
  <div class="container-fluid p-0 mb-3 bg-primary-subtle">
    <div class="container">
      <h1 class="text-center">
        {{ 'home.h1'|trans }}
      </h1>
      <div class="px-4 fs-5 text-center">
        {{ 'home.text'|trans|raw }}
      </div>
    </div>
  </div>
{% endblock %}

{% block main %}
  <div class="container">
    {# {{ block('flash', 'theme/flash.html.twig') }} #}
    {% for category in categories %}
      {% if (category.applis|length) > 0 %}
        <section class="mb-4" data-controller="main-carousel" data-main-carousel-id-value="{{ category.id }}">
          <div class="d-flex justify-content-start gap-1 gap-md-3 mb-4">
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-prev"><span class="fa-solid fa-chevron-left fa-xl"></span></button>
            <div class="swiper mx-0" id="swiper-{{ category.id }}-main">
              <h2 class="mb-3 text-center text-md-start">
                {{ category.icon.faClass|fmt_fa_class('fa-fw me-2')|raw }} {{ category.label }}
              </h2>
              <div class="swiper-wrapper">
                {% for appli in category.applis %}
                  {% set appli_url = server_base_url ~ appli.path %}
                  <div class="card swiper-slide">
                    <a href="{{ appli_url }}" class="card-img rounded-bottom-0 d-flex align-items-center" data-turbo="false">
                      {{ appli|fmt_image_file('title', 'card-img-top')|raw }}
                    </a>
                    <div class="card-body bg-light d-flex flex-column justify-content-between">
                      <h5 class="card-title">
                        {{ appli.title }}
                      </h5>
                      <p class="card-text flex-grow-1">
                        {{ appli.description }}
                      </p>
                      <div class="d-flex flex-row gap-2 justify-content-start align-items-end">
                        <div class="flex-fill text-start">
                          <a href="{{ appli_url }}" class="btn btn-primary" data-turbo="false">{{ appli.linkText }}</a>
                        </div>
                        {% for externalLink in appli.externalLinks %}
                          <div>
                            <a href="{{ externalLink.url }}" class="btn btn-sm btn-outline-secondary py-0 px-1 fs-5" title="{{ externalLink.text }}" data-turbo="false">
                              <span class="{{ externalLink.icon.faClass }}"></span>
                            </a>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-next"><span class="fa-solid fa-chevron-right fa-xl"></span></button>
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
