{% extends 'base.html.twig' %}

{% set title = 'home.title'|trans %}

{% block h1 %}
  <div class="container-fluid p-0 mb-3 border-2 app-home-gradient bg-primary-subtle">
    <div class="container">
      <h1 class="text-center">
        {{ 'home.h1'|trans }}
      </h1>
      <div class="px-4 fs-5 text-center">
        <p class="mb-0">
          {{ 'home.introText'|trans|raw }}
        </p>
        <p class="app-home-havefun mb-0">
          <span class="px-4 py-1 fs-4 border border-1 rounded-5 bg-primary-subtle">{{ 'home.haveFun'|trans }}</span>
        </p>
      </div>
    </div>
  </div>
{% endblock %}

{% block main %}
  <div class="container">
    {# No flashes on the main home page #}
    {# {{ block('flash', 'theme/flash.html.twig') }} #}
    {% for category in categories %}
      {% if (category.applis|length) > 0 %}
        <section class="mb-4" data-controller="main-carousel" data-main-carousel-id-value="{{ category.id }}">
          <div class="d-flex justify-content-start gap-1 gap-md-3 mb-4">
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-prev" aria-label="{{ 'form.button.previous'|trans }}">
              <span class="fa-solid fa-chevron-left fa-xl" aria-hidden="true"></span>
            </button>
            <div class="swiper mx-0" id="swiper-{{ category.id }}-main">
              <h2 class="mb-3 text-center text-md-start">
                <span class="{{ category.icon.faClass|e }} fa-fw me-2"></span> {{ category.label }}
              </h2>
              <div class="swiper-wrapper">
                {% for appli in category.applis %}
                  {% set appli_url = server_base_url ~ appli.path %}
                  <div class="card swiper-slide">
                    <a href="{{ appli_url }}" class="card-img rounded-bottom-0 d-flex align-items-center bg-primary-subtle" data-turbo="false">
                      <img src="{{ appli|get_image_path('default-appli.png') }}" class="card-img-top" alt="{{ appli.title }}" />
                    </a>
                    <div class="card-body bg-light d-flex flex-column justify-content-between">
                      <h5 class="card-title">
                        {{ appli.title }}
                      </h5>
                      <p class="card-text flex-grow-1">
                        {{ appli.description }}
                      </p>
                      <div class="d-flex flex-row gap-2 justify-content-start align-items-end">
                        <div class="flex-fill text-start">
                          <a href="{{ appli_url }}" class="btn btn-primary" data-turbo="false">{{ appli.linkText }}</a>
                        </div>
                        {% for externalLink in appli.externalLinks %}
                          <div>
                            <a href="{{ externalLink.url }}" class="btn btn-sm btn-outline-secondary py-0 px-1 fs-5" title="{{ externalLink.text }}" data-turbo="false">
                              <span class="{{ externalLink.icon.faClass }}"></span>
                            </a>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
            <button type="button" class="btn btn-swiper mt-5" id="swiper-{{ category.id }}-button-next" aria-label="{{ 'form.button.next'|trans }}">
              <span class="fa-solid fa-chevron-right fa-xl" aria-hidden="true"></span>
            </button>
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
